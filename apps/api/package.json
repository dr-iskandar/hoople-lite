{
  "name": "@hoople/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "db:setup:ci": "node --import tsx src/db/ci-setup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "fastify": "^5.12.8",
    "openid-client": "^6.8.8",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
