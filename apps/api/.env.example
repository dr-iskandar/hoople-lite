# Copy to apps/api/.env locally. Never commit real credentials.
HOST=127.0.0.1
PORT=4000
# API live health works without DB; ready health stays 503 until configured.
DATABASE_URL=postgresql://hoople_api:replace_me@127.0.0.1:5432/hoople_lite
# OIDC creator sign-in. Configure ALL fields to enable login.
# Database must have 0001 + 0002 migrations and restricted runtime grants.
# Never commit secrets or a real .env file.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=replace-with-your-oidc-client-id
OIDC_CLIENT_SECRET=replace-with-your-oidc-client-secret
OIDC_REDIRECT_URI=http://localhost:4000/v1/auth/callback
WEB_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=replace-with-random-32-byte-base64-value
# Development ONLY, when web and callback hosts are localhost.
COOKIE_SECURE=false

# HoPay STAGING ONLY. Set all four variables in a server-side secrets manager.
# Do not use VITE_* (browser-visible) names for payment credentials.
# The API only permits the exact staging payment endpoint below.
HOPAY_ENDPOINT=https://dev-api-payment.hoople.co.id/payment
HOPAY_CLIENT_ID=replace-with-your-staging-client-uuid
HOPAY_API_KEY=replace-with-your-staging-secret
# Public HTTPS backend callback; currently deliberately quarantines unsigned events.
HOPAY_CALLBACK_URL=https://api-staging.example.com/v1/billing/callback
# Public HTTPS SPA return URL, same origin as WEB_ORIGIN. A redirect is not proof of payment.
HOPAY_FINISH_URL=https://studio-staging.example.com/?payment=return
